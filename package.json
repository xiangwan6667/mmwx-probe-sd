    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/twemoji": "^13.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
