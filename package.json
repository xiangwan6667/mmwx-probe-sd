{
  "name": "mmwx-probe-sd",
  "private": true,
  "version": "0.1.0",
  "description": "mmwx-probe-sd: unofficial customized probe frontend based on mmwx-group/mmwx-probe",
  "cloudflare": {
    "bindings": {
      "MMWX_ORIGIN": {
        "description": "妙妙屋 X 主控的公网 HTTPS 地址，例如 `https://panel.example.com`。"
      },
      "PROBE_TOKEN": {
        "description": "在主控的 **系统设置 → 探针** 中生成的独立探针访问密钥。"
      }
    }
  },
  "type": "module",
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-accordion": "^1.2.20",
